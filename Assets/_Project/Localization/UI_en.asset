      m_Items: []
  - m_Id: 190000000000012
    m_Localized: Acid bottle
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000013
    m_Localized: A bottle of hydrochloric acid stands open on the bench. What is
      the safest action?
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000014
    m_Localized: Smell it to find out how strong it is.
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000015
    m_Localized: Close it and put it back in the acid cabinet.
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000016
    m_Localized: 'Leave it open: someone may still be using it.'
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000017
    m_Localized: 'Not safe: open acid gives off fumes and can be knocked over.'
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000018
    m_Localized: 'Practice: spill on the bench'
