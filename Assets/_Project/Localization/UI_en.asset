    m_Metadata:
      m_Items: []
  - m_Id: 4457488430
    m_Localized: 'Safety-critical: always in the run and must be answered correctly.'
    m_Metadata:
      m_Items: []
  - m_Id: 4457488431
    m_Localized: Switch all on
    m_Metadata:
      m_Items: []
  - m_Id: 4457488432
    m_Localized: At least one hazard has to stay on.
    m_Metadata:
      m_Items: []
  - m_Id: 4457488433
    m_Localized: Each run plants {0} of the {1} hazards that are on, picked at random.
    m_Metadata:
      m_Items: []
  - m_Id: 4457488434
    m_Localized: "BSL-1 laboratory \xB7 {0} hidden hazards \xB7 7 minutes"
    m_Metadata:
      m_Items: []
