  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4365213696
    m_Localized: 'Inspektion gestartet: {0} Zeit. Finden Sie alle {1} Gefahren!'
    m_Metadata:
      m_Items: []
  - m_Id: 4453294080
    m_Localized: Ergebnisse werden berechnet...
    m_Metadata:
      m_Items: []
  - m_Id: 4457488384
    m_Localized: "Zeigen Sie auf eine Antwort, ziehen Sie den Trigger und dr\xFCcken
      Sie dann A zum Absenden."
    m_Metadata:
      m_Items: []
  - m_Id: 4457488385
    m_Localized: "Gef\xE4hrliche Wahl, f\xFCr die Sicherheitspr\xFCfung erfasst.
      W\xE4hlen Sie erneut."
    m_Metadata:
      m_Items: []
  - m_Id: 4457488386
    m_Localized: "Als Fehler erfasst. W\xE4hlen Sie erneut."
    m_Metadata:
      m_Items: []
  - m_Id: 4457488387
    m_Localized: Antwort {0} absenden
    m_Metadata:
      m_Items: []
  - m_Id: 4457488388
    m_Localized: Absenden
    m_Metadata:
      m_Items: []
  - m_Id: 4457488389
    m_Localized: Inspektion beenden?
    m_Metadata:
      m_Items: []
  - m_Id: 4457488390
    m_Localized: "M\xF6glicherweise haben Sie Gefahren \xFCbersehen. Alles, was Sie
      nicht gefunden haben, gilt als \xFCbersehen.\nWeiter inspizieren oder jetzt
      absenden?"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488391
    m_Localized: Inspektion jetzt absenden?
    m_Metadata:
      m_Items: []
  - m_Id: 4457488392
    m_Localized: Weiter
    m_Metadata:
      m_Items: []
  - m_Id: 4457488393
    m_Localized: "Behoben <b>{0}/{1}</b>\n<color={2}>X ausblenden  \xB7  Y Hinweise</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488394
    m_Localized: "GEF\xC4HRLICH"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488395
    m_Localized: "Schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488396
    m_Localized: Steuerung
    m_Metadata:
      m_Items: []
  - m_Id: 4457488397
    m_Localized: "<b>WASD</b> gehen\n<b>Rechte Maustaste halten</b> umsehen\n<b>Linksklick</b>
      ausw\xE4hlen\n<b>Enter</b> absenden   <b>Esc</b> schlie\xDFen\n<b>H</b> Aufgabenanzeige
      (mit Beenden)"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488398
    m_Localized: "<b><color={0}>Trigger</color></b>  ausw\xE4hlen / pr\xFCfen\n<b>Stick
      nach vorn</b>  zielen, loslassen zum Teleportieren\n<b>Stick links/rechts</b> 
      45\xB0 drehen    <b>zur\xFCck</b>  umdrehen\n<b>A</b>  absenden    <b>B</b> 
      schlie\xDFen\n<b>X</b>  Aufgabenanzeige    <b>Y</b>  Hinweise"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488399
    m_Localized: LABOR-SICHERHEITSINSPEKTION
    m_Metadata:
      m_Items: []
  - m_Id: 4457488400
    m_Localized: verbleibend
    m_Metadata:
      m_Items: []
  - m_Id: 4457488401
    m_Localized: Inspektionsstation
    m_Metadata:
      m_Items: []
  - m_Id: 4457488402
    m_Localized: "Fr\xFCher fertig? Hier absenden oder Y / Menu dr\xFCcken."
    m_Metadata:
      m_Items: []
  - m_Id: 4457488403
    m_Localized: Inspektion beenden
    m_Metadata:
      m_Items: []
  - m_Id: 4457488404
    m_Localized: Sieht gut aus. Weiter inspizieren.
    m_Metadata:
      m_Items: []
  - m_Id: 4457488405
    m_Localized: '{0}: sieht gut aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 4457488406
    m_Localized: 'Gefahr behoben: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 4457488407
    m_Localized: Zeit abgelaufen!
    m_Metadata:
      m_Items: []
  - m_Id: 4457488408
    m_Localized: Alle Gefahren behoben!
    m_Metadata:
      m_Items: []
  - m_Id: 4457488409
    m_Localized: Inspektion abgesendet
    m_Metadata:
      m_Items: []
  - m_Id: 4457488410
    m_Localized: Sehr gut! Stick nach vorn teleportiert, links/rechts dreht.
    m_Metadata:
      m_Items: []
  - m_Id: 4457488413
    m_Localized: Erledigt
    m_Metadata:
      m_Items: []
  - m_Id: 4457488417
    m_Localized: Labor starten
    m_Metadata:
      m_Items: []
  - m_Id: 4457488418
    m_Localized: Entwickelt von Studierenden der TUM und ETH
    m_Metadata:
      m_Items: []
  - m_Id: 4457488419
    m_Localized: Labor-Sicherheitsinspektion
    m_Metadata:
      m_Items: []
  - m_Id: 4457488420
    m_Localized: SPRACHE
    m_Metadata:
      m_Items: []
  - m_Id: 4457488421
    m_Localized: GEFAHREN
    m_Metadata:
      m_Items: []
  - m_Id: 4457488422
    m_Localized: "Gefahren w\xE4hlen"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488425
    m_Localized: Gefahren im Labor
    m_Metadata:
      m_Items: []
  - m_Id: 4457488426
    m_Localized: "Schalten Sie Gefahren ein oder aus und w\xE4hlen Sie, wie viele
      pro Durchgang platziert werden."
    m_Metadata:
      m_Items: []
  - m_Id: 4457488427
    m_Localized: PLATZIERTE GEFAHREN
    m_Metadata:
      m_Items: []
  - m_Id: 4457488428
    m_Localized: AUS
    m_Metadata:
      m_Items: []
  - m_Id: 4457488429
    m_Localized: GEFAHREN PRO DURCHGANG
    m_Metadata:
      m_Items: []
  - m_Id: 4457488430
    m_Localized: 'Sicherheitskritisch: immer dabei, zum Bestehen richtig beantworten.'
    m_Metadata:
      m_Items: []
  - m_Id: 4457488431
    m_Localized: Alle einschalten
    m_Metadata:
      m_Items: []
  - m_Id: 4457488432
    m_Localized: Mindestens eine Gefahr muss eingeschaltet bleiben.
    m_Metadata:
      m_Items: []
  - m_Id: 4457488433
    m_Localized: "Jeder Durchgang platziert zuf\xE4llig {0} der {1} eingeschalteten
      Gefahren."
    m_Metadata:
      m_Items: []
  - m_Id: 4457488434
    m_Localized: "BSL-1-Labor \xB7 {0} versteckte Gefahren \xB7 7 Minuten"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488437
    m_Localized: "TRIGGER\n<size=70%>ausw\xE4hlen</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488438
    m_Localized: 'STICK

      <size=70%>teleportieren / drehen</size>'
    m_Metadata:
      m_Items: []
  - m_Id: 4457488440
    m_Localized: "ID {0} \xB7 Sitzung {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488441
    m_Localized: Bewertungsergebnis
    m_Metadata:
      m_Items: []
  - m_Id: 4457488442
    m_Localized: "Sicherheitspr\xFCfung erforderlich"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488443
    m_Localized: Nachschulung erforderlich
    m_Metadata:
      m_Items: []
  - m_Id: 4457488444
    m_Localized: Bestanden
    m_Metadata:
      m_Items: []
  - m_Id: 4457488445
    m_Localized: Gefahrenerkennung
    m_Metadata:
      m_Items: []
  - m_Id: 4457488446
    m_Localized: '{0} / {1} Punkte'
    m_Metadata:
      m_Items: []
  - m_Id: 4457488447
    m_Localized: Richtige Entscheidungen
    m_Metadata:
      m_Items: []
  - m_Id: 4457488448
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 4457488449
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 4457488450
    m_Localized: Punktzahl
    m_Metadata:
      m_Items: []
  - m_Id: 4457488451
    m_Localized: Mindestpunktzahl erreicht
    m_Metadata:
      m_Items: []
  - m_Id: 4457488452
    m_Localized: Mindesterkennung erreicht
    m_Metadata:
      m_Items: []
  - m_Id: 4457488453
    m_Localized: Mindestanzahl Entscheidungen erreicht
    m_Metadata:
      m_Items: []
  - m_Id: 4457488454
    m_Localized: Alle kritischen Gefahren richtig
    m_Metadata:
      m_Items: []
  - m_Id: 4457488455
    m_Localized: Keine kritisch unsichere Wahl
    m_Metadata:
      m_Items: []
  - m_Id: 4457488456
    m_Localized: "Sie haben {0} gew\xE4hlt: {1}. Dies ist eine kritisch unsichere
      Wahl, denn {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488457
    m_Localized: Sie haben diese Gefahr nicht gefunden.
    m_Metadata:
      m_Items: []
  - m_Id: 4457488458
    m_Localized: Gefunden, aber keine Antwort abgesendet.
    m_Metadata:
      m_Items: []
  - m_Id: 4457488459
    m_Localized: "Sie haben {0} statt {1} gew\xE4hlt. {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488460
    m_Localized: "+ {0} weitere: siehe Erkl\xE4rungen"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488461
    m_Localized: 'Keine Probleme: Jede Gefahr wurde gefunden und richtig behandelt.'
    m_Metadata:
      m_Items: []
  - m_Id: 4457488462
    m_Localized: Noch nicht qualifiziert
    m_Metadata:
      m_Items: []
  - m_Id: 4457488463
    m_Localized: Qualifiziert
    m_Metadata:
      m_Items: []
  - m_Id: 4457488464
    m_Localized: "Abschlie\xDFende Entscheidung: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488465
    m_Localized: "Erkl\xE4rungen ansehen"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488466
    m_Localized: "Zur\xFCck zur Lobby"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488467
    m_Localized: Erneut spielen
    m_Metadata:
      m_Items: []
  - m_Id: 4457488468
    m_Localized: 'Exportiert: {0}  (+ .csv)'
    m_Metadata:
      m_Items: []
  - m_Id: 4457488469
    m_Localized: "Sie haben {0}/100 Punkte erreicht, aber eine sicherheitskritische
      Anforderung nicht erf\xFCllt. Arbeiten Sie die Verfahren zu {1} erneut durch
      und wiederholen Sie die Bewertung."
    m_Metadata:
      m_Items: []
  - m_Id: 4457488470
    m_Localized: "Mit {0}/100 haben Sie die Mindestanforderungen nicht erf\xFCllt.
      Befassen Sie sich erneut mit {1} und wiederholen Sie die Bewertung."
    m_Metadata:
      m_Items: []
  - m_Id: 4457488471
    m_Localized: Sie haben mit {0}/100 und ohne sicherheitskritische Fehler Ihre
      Kompetenz nachgewiesen.
    m_Metadata:
      m_Items: []
  - m_Id: 4457488472
    m_Localized: "\xDCbersehen haben Sie au\xDFerdem: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 4457488473
    m_Localized: "\xDCbersehen haben Sie au\xDFerdem: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 4457488474
    m_Localized: relevanten Sicherheitsthemen
    m_Metadata:
      m_Items: []
  - m_Id: 4457488475
    m_Localized: ' und '
    m_Metadata:
      m_Items: []
  - m_Id: 4457488476
    m_Localized: "Erkl\xE4rungen"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488477
    m_Localized: nicht beantwortet
    m_Metadata:
      m_Items: []
  - m_Id: 4457488478
    m_Localized: nicht gefunden
    m_Metadata:
      m_Items: []
  - m_Id: 4457488479
    m_Localized: richtig
    m_Metadata:
      m_Items: []
  - m_Id: 4457488480
    m_Localized: 'Ihre Wahl: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 4457488481
    m_Localized: "Schlie\xDFen  (B)"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488482
    m_Localized: Noch kein Durchgang
    m_Metadata:
      m_Items: []
  - m_Id: 4457488483
    m_Localized: Starten Sie in der Lobby, um das Labor zu spielen und hier Ihre
      Ergebnisse zu sehen.
    m_Metadata:
      m_Items: []
  - m_Id: 4457488484
    m_Localized: Zur Lobby
    m_Metadata:
      m_Items: []
  - m_Id: 4457488485
    m_Localized: "MOCKUP \xB7 STATISCHE DATEN"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488486
    m_Localized: Beispiel-Bestenliste
    m_Metadata:
      m_Items: []
  - m_Id: 4457488487
    m_Localized: Beispielnamen und -punkte, keine echten Ergebnisse
    m_Metadata:
      m_Items: []
  - m_Id: 4457488488
    m_Localized: Sie
    m_Metadata:
      m_Items: []
  - m_Id: 4457488489
    m_Localized: Waage
    m_Metadata:
      m_Items: []
  - m_Id: 4457488490
    m_Localized: Zentrifuge
    m_Metadata:
      m_Items: []
  - m_Id: 4457488491
    m_Localized: Saubere Glaswaren
    m_Metadata:
      m_Items: []
  - m_Id: 4457488492
    m_Localized: "Kittelst\xE4nder"
    m_Metadata:
      m_Items: []
  - m_Id: 4457488493
    m_Localized: "Schrank f\xFCr \xE4tzende Stoffe"
    m_Metadata:
      m_Items: []
  - m_Id: 4461682688
    m_Localized: Augendusche
    m_Metadata:
      m_Items: []
  - m_Id: 4461682689
    m_Localized: "Feuerl\xF6scher"
    m_Metadata:
      m_Items: []
  - m_Id: 4461682690
    m_Localized: Abzug
    m_Metadata:
      m_Items: []
  - m_Id: 4461682691
    m_Localized: Heizplatte
    m_Metadata:
      m_Items: []
  - m_Id: 4461682692
    m_Localized: Laborbuch
    m_Metadata:
      m_Items: []
  - m_Id: 4461682693
    m_Localized: "Laborabfallbeh\xE4lter"
    m_Metadata:
      m_Items: []
  - m_Id: 4461682694
    m_Localized: Beschriftete Pufferflaschen
    m_Metadata:
      m_Items: []
  - m_Id: 4461682695
    m_Localized: "Beschriftete Kochsalzl\xF6sung"
    m_Metadata:
      m_Items: []
  - m_Id: 4461682696
    m_Localized: Laptop
    m_Metadata:
      m_Items: []
  - m_Id: 4461682697
    m_Localized: Pipetten
    m_Metadata:
      m_Items: []
  - m_Id: 4461682698
    m_Localized: "Recyclingbeh\xE4lter"
    m_Metadata:
      m_Items: []
  - m_Id: 4461682699
    m_Localized: "Probenr\xF6hrchen-St\xE4nder"
    m_Metadata:
      m_Items: []
  - m_Id: 4461682700
    m_Localized: "Sp\xFClbecken"
    m_Metadata:
      m_Items: []
  - m_Id: 10469552152576
    m_Localized: "<b>Trigger</b>  ausw\xE4hlen"
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232961
    m_Localized: "<b>Stick</b>  teleportieren \xB7 drehen"
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232962
    m_Localized: absenden
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232963
    m_Localized: "schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232964
    m_Localized: Aufgaben
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232965
    m_Localized: beenden
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232966
    m_Localized: "absenden \xB7 Labor starten"
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232968
    m_Localized: <b>Teleportieren</b> Sie sich auf den leuchtenden Ring
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232969
    m_Localized: <b>Drehen</b> Sie sich zum Labortisch
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232970
    m_Localized: "<b>Pr\xFCfen</b> Sie die geschlossene Flasche"
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232971
    m_Localized: "<b>Beantworten</b> Sie die Frage zur offenen S\xE4ure"
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232972
    m_Localized: "<b>W\xE4hlen Sie eine gef\xE4hrliche Antwort</b> zur Pf\xFCtze"
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232973
    m_Localized: "Einen Stick nach vorn dr\xFCcken, den Bogen auf den Ring am Boden
      richten und loslassen."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232974
    m_Localized: "Stick zweimal kurz nach rechts (2 \xD7 45\xB0), um den Tisch rechts
      von Ihnen anzusehen. Nach hinten ziehen: umdrehen."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232975
    m_Localized: Zeigen Sie auf die geschlossene, beschriftete Flasche und ziehen
      Sie den Trigger. Nicht alles im Labor ist eine Gefahr.
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232976
    m_Localized: "Pr\xFCfen Sie die offene Flasche daneben, w\xE4hlen Sie mit dem
      Trigger eine Antwort und dr\xFCcken Sie A. Richtig: gr\xFCner Haken."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232977
    m_Localized: "Teleportieren Sie sich zum n\xE4chsten Ring und pr\xFCfen Sie die
      Pf\xFCtze. W\xE4hlen Sie absichtlich \u201EMit der blo\xDFen Hand aufwischen.\u201C,
      dann die sichere Antwort."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232982
    m_Localized: "<color={0}>X ausblenden  \xB7  Y Hinweise</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232984
    m_Localized: "\xDCbungsfrage  /  ohne Wertung"
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232990
    m_Localized: Richtig! Im Labor ist die Gefahr damit behoben.
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232991
    m_Localized: "Gut gedreht! Stick zur\xFCckziehen dreht Sie ganz um."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232992
    m_Localized: Das ist Ihre Aufgabenanzeige. Im Labor zeigt sie Zeit und Checkliste.
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232993
    m_Localized: "So l\xE4uft die Inspektion ab"
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232994
    m_Localized: <b>Finden Sie die Gefahren.</b> Sie sind im Labor versteckt. Sie
      haben 7 Minuten.
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232995
    m_Localized: "<b>W\xE4hlen Sie die sicherste Ma\xDFnahme.</b> Trigger w\xE4hlt
      eine Antwort, A sendet sie ab."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232996
    m_Localized: "<b>Richtige Antwort:</b> gr\xFCner Haken. Die Gefahr gilt als behoben."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232997
    m_Localized: "<b>Falsche Antwort:</b> rotes Kreuz, als Fehler erfasst. W\xE4hlen
      Sie erneut."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232998
    m_Localized: "<b>Eine gef\xE4hrliche erste Antwort</b> f\xFChrt zu einer Sicherheitspr\xFCfung."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640232999
    m_Localized: "<b>Blauer Umriss:</b> bereits gepr\xFCft."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640233000
    m_Localized: "Punkte: 3 pro gefundener Gefahr, 7 pro richtiger erster Antwort.
      Vorzeitig beenden: \u201EBeenden\u201C in der Aufgabenanzeige."
    m_Metadata:
      m_Items: []
  - m_Id: 10469640233001
    m_Localized: 'VORSICHT

      <size=60%>Chemikalien in Gebrauch</size>'
    m_Metadata:
      m_Items: []
  - m_Id: 10469640233002
    m_Localized: Essen und Trinken im Labor verboten
    m_Metadata:
      m_Items: []
  - m_Id: 10469640233003
    m_Localized: Laborkittel und Schutzbrille tragen
    m_Metadata:
      m_Items: []
  - m_Id: 10469640233004
    m_Localized: Notfall-Augendusche
    m_Metadata:
      m_Items: []
  - m_Id: 170661547859968
    m_Localized: 'Sieht gut aus. Das war der {0}. Fehlalarm: ab jetzt kostet jeder
      1 Punkt.'
    m_Metadata:
      m_Items: []
  - m_Id: 170661610774528
    m_Localized: "{0} / {1} Punkte (-{2} f\xFCr Fehlalarme)"
    m_Metadata:
      m_Items: []
  - m_Id: 174458764517376
    m_Localized: STUDIERENDEN-ID
    m_Metadata:
      m_Items: []
  - m_Id: 174458898735104
    m_Localized: Studierenden-ID eingeben
    m_Metadata:
      m_Items: []
  - m_Id: 174458902929408
    m_Localized: Nur Ziffern. Damit findet Ihre Lehrperson Ihre Ergebnisse.
    m_Metadata:
      m_Items: []
  - m_Id: 174458902929409
    m_Localized: "L\xF6schen"
    m_Metadata:
      m_Items: []
  - m_Id: 174458902929410
    m_Localized: "Best\xE4tigen und starten"
    m_Metadata:
      m_Items: []
  - m_Id: 175657316245504
    m_Localized: DOMINANTE HAND
    m_Metadata:
      m_Items: []
  - m_Id: 175657374965760
    m_Localized: Rechts
    m_Metadata:
      m_Items: []
  - m_Id: 175657374965761
    m_Localized: Links
    m_Metadata:
      m_Items: []
  - m_Id: 180335206719488
    m_Localized: Details
    m_Metadata:
      m_Items: []
  - m_Id: 180335294799872
    m_Localized: Ergebnis
    m_Metadata:
      m_Items: []
  - m_Id: 180335294799873
    m_Localized: Bestehensbedingungen und Probleme
    m_Metadata:
      m_Items: []
  - m_Id: 180335294799874
    m_Localized: "Zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 180335294799875
    m_Localized: Weiter
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000000
    m_Localized: Aufgabenanzeige <b>aus- und einblenden</b>
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000001
    m_Localized: "Dr\xFCcken Sie X am linken Controller, um die Aufgabenanzeige auszublenden,
      und erneut X, um sie zur\xFCckzuholen."
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000002
    m_Localized: "Dr\xFCcken Sie A am rechten Controller, um die Aufgabenanzeige
      auszublenden, und erneut A, um sie zur\xFCckzuholen."
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000003
    m_Localized: "<b>Beenden</b> Sie an der Labort\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000004
    m_Localized: "Teleportieren Sie sich zur T\xFCr, zielen Sie mit dem anderen Controller
      auf \u201EBeenden\u201C in der Aufgabenanzeige und dr\xFCcken Sie den Trigger:
      So beenden Sie im Labor vorzeitig."
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000005
    m_Localized: "EINF\xDCHRUNG  \xB7  SCHRITT {0} VON {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000006
    m_Localized: Direkt ins Labor
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000007
    m_Localized: Ins Labor
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000008
    m_Localized: 'Zuerst: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000009
    m_Localized: verbleibend (Demo)
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000010
    m_Localized: 'Sieht gut aus: geschlossen und beschriftet. Im Labor kostet ab
      dem 4. Fehlalarm jeder 1 Punkt.'
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000011
    m_Localized: "\xDCbung: offene S\xE4ureflasche"
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000012
    m_Localized: "S\xE4ureflasche"
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000013
    m_Localized: "Eine Flasche Salzs\xE4ure steht offen auf dem Labortisch. Was ist
      die sicherste Ma\xDFnahme?"
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000014
    m_Localized: "Daran riechen, um zu pr\xFCfen, wie stark sie ist."
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000015
    m_Localized: "Verschlie\xDFen und zur\xFCck in den S\xE4ureschrank stellen."
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000016
    m_Localized: 'Offen lassen: Vielleicht braucht sie noch jemand.'
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000017
    m_Localized: "Nicht sicher: Offene S\xE4ure gast aus und kann umkippen."
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000018
    m_Localized: "\xDCbung: Pf\xFCtze auf dem Labortisch"
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000019
    m_Localized: "Pf\xFCtze"
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000020
    m_Localized: "Eine klare Fl\xFCssigkeit ist auf dem Tisch versch\xFCttet. Sie
      wissen nicht, was es ist. Was tun Sie?"
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000021
    m_Localized: "Mit der blo\xDFen Hand aufwischen."
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000022
    m_Localized: Andere fernhalten, die Aufsicht informieren und mit Handschuhen
      das Notfallset verwenden.
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000023
    m_Localized: "Mit Papiert\xFCchern abdecken und weiterarbeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000024
    m_Localized: "Nicht sicher: Eine unbekannte Fl\xFCssigkeit kann die Haut ver\xE4tzen
      oder reagieren."
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000025
    m_Localized: "Richtig! W\xE4hlen Sie in diesem Schritt zuerst absichtlich \u201EMit
      der blo\xDFen Hand aufwischen.\u201C"
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000026
    m_Localized: "Bereit f\xFCrs Labor?"
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000027
    m_Localized: 'Im Labor reicht diese Abfrage Ihre Inspektion ein und beendet den
      Durchgang. Hier bringt A Sie ins Labor: Dort startet die Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000028
    m_Localized: "Danach: ein kurzer \xDCbungsraum (etwa 3 Minuten), dann das Labor."
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000101
    m_Localized: Nochmals ansehen ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000102
    m_Localized: Richtig ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 190000000000103
    m_Localized: 'Richtig: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 225511996383232
    m_Localized: Entwicklermodus
    m_Metadata:
      m_Items: []
  - m_Id: 225512097046528
    m_Localized: "Entwicklermodus: W\xE4hlen Sie eine Gefahr, um zu sehen, wo sie
      platziert werden kann. Dieser Durchgang wird nicht gespeichert."
    m_Metadata:
      m_Items: []
  - m_Id: 227090677882880
    m_Localized: "Beenden\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 227090765963264
    m_Localized: Hinweise
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
