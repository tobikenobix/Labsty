%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Hazards_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 080672767c5e81148882c1431d55fcbe, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1139793920
    m_Localized: "Bienvenue au laboratoire ! Avant de commencer vos recherches, vous
      devez effectuer une inspection de s\xE9curit\xE9. Certains \xE9l\xE9ments de
      ce labo sont dangereux. Saurez-vous les trouver et d\xE9cider comment y rem\xE9dier
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931264
    m_Localized: "Sortie de secours bloqu\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931265
    m_Localized: "Entr\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931266
    m_Localized: Facile
    m_Metadata:
      m_Items: []
  - m_Id: 1185931267
    m_Localized: "Acc\xE8s d'urgence"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931268
    m_Localized: "Voies d'\xE9vacuation"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931269
    m_Localized: "Les sorties de secours doivent \xEAtre d\xE9gag\xE9es \xE0 100
      % en permanence. Rangez le chariot dans une zone de stockage pr\xE9vue, ne
      vous contentez pas de le pousser sur le c\xF4t\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931270
    m_Localized: "une sortie de secours ne doit jamais \xEAtre bloqu\xE9e ni partiellement
      obstru\xE9e, m\xEAme bri\xE8vement."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931271
    m_Localized: "Ce n'est pas s\xFBr : une sortie de secours doit \xEAtre enti\xE8rement
      d\xE9gag\xE9e en permanence."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931272
    m_Localized: "La personne \xE9valu\xE9e n'a pas remarqu\xE9 que la sortie de
      secours \xE9tait bloqu\xE9e par un chariot."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931273
    m_Localized: Que faire du chariot qui bloque la sortie de secours ?
    m_Metadata:
      m_Items: []
  - m_Id: 1185931274
    m_Localized: "D\xE9placer le chariot juste assez pour laisser passer une personne."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931275
    m_Localized: "Ranger le chariot dans la zone de stockage, en laissant la sortie
      enti\xE8rement d\xE9gag\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931276
    m_Localized: "Laisser le chariot jusqu'\xE0 la prochaine livraison pr\xE9vue."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931277
    m_Localized: Poser un panneau d'avertissement sur le chariot pour alerter les
      autres.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931278
    m_Localized: "Comment v\xE9rifier que la sortie de secours est utilisable en
      toute s\xE9curit\xE9 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931279
    m_Localized: Le panneau vert de sortie de secours est bien visible.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931280
    m_Localized: Le chariot ne touche plus la porte de secours.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931281
    m_Localized: "Une personne peut franchir la porte de c\xF4t\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931282
    m_Localized: "La porte et toute la voie d'\xE9vacuation sont d\xE9gag\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931283
    m_Localized: "L'\xE9quipe aura de nouveau besoin du chariot dans dix minutes.
      Que faire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931284
    m_Localized: "Le garer dans une zone pr\xE9vue, \xE0 l'\xE9cart de la sortie."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931285
    m_Localized: "Le laisser pr\xE8s de la sortie avec un peu d'espace de passage."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931286
    m_Localized: "Le laisser l\u00e0 et programmer un rappel pour le d\u00e9placer plus tard."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931287
    m_Localized: "Le d\xE9placer devant une autre porte de secours."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931288
    m_Localized: Nourriture et boisson sur la paillasse
    m_Metadata:
      m_Items: []
  - m_Id: 1185931289
    m_Localized: Paillasse principale
    m_Metadata:
      m_Items: []
  - m_Id: 1185931290
    m_Localized: Facile
    m_Metadata:
      m_Items: []
  - m_Id: 1185931291
    m_Localized: "Hygi\xE8ne / contamination"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931292
    m_Localized: EPI et comportement
    m_Metadata:
      m_Items: []
  - m_Id: 1185931293
    m_Localized: La nourriture et les boissons sont strictement interdites au laboratoire
      en raison du risque d'ingestion et de contamination.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931294
    m_Localized: "Ce n'est pas s\xFBr : la nourriture et les boissons ne sont jamais
      autoris\xE9es au labo."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931295
    m_Localized: "La personne \xE9valu\xE9e n'a pas remarqu\xE9 la nourriture et
      la boisson sur la paillasse."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931296
    m_Localized: "Vous remarquez une tasse de caf\xE9 \xE0 c\xF4t\xE9 d'un \xE9quipement
      de labo en service. Que faire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931297
    m_Localized: "D\xE9placer la tasse \xE0 l'autre bout de la paillasse."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931298
    m_Localized: "Fermer le couvercle et poursuivre l'exp\xE9rience comme pr\xE9vu."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931299
    m_Localized: "Emporter la boisson dans une zone autoris\xE9e hors du laboratoire."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931300
    m_Localized: "Ranger la tasse dans un tiroir jusqu'\xE0 la fin du travail."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931301
    m_Localized: "Un coll\xE8gue veut un caf\xE9 pendant une longue exp\xE9rience.
      Que lui sugg\xE9rer ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931302
    m_Localized: "Faire une pause et boire dans une zone autoris\xE9e hors du labo."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931303
    m_Localized: Utiliser une tasse anti-renversement au bord de la paillasse.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931304
    m_Localized: "Demander \xE0 quelqu'un de tenir la tasse loin des \xE9chantillons."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931305
    m_Localized: "Garder la boisson ferm\xE9e jusqu'\xE0 la fin de l'exp\xE9rience."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931306
    m_Localized: "Pourquoi une tasse de caf\xE9 ferm\xE9e pose-t-elle quand m\xEAme
      un probl\xE8me de s\xE9curit\xE9 au laboratoire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931307
    m_Localized: "La tasse pourrait se renverser sur l'exp\u00e9rience."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931308
    m_Localized: "Le r\xE9cipient pourrait r\xE9duire l'espace de travail disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931309
    m_Localized: "La chaleur du caf\u00e9 pourrait alt\u00e9rer les \u00e9chantillons voisins."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931310
    m_Localized: "Les r\u00e9sidus de vos mains et de la tasse finissent dans votre bouche."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931311
    m_Localized: "Cartons empil\xE9s de fa\xE7on instable"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931312
    m_Localized: "Entr\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931313
    m_Localized: Facile
    m_Metadata:
      m_Items: []
  - m_Id: 1185931314
    m_Localized: Physique / chutes d'objets
    m_Metadata:
      m_Items: []
  - m_Id: 1185931315
    m_Localized: "Voies d'\xE9vacuation"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931316
    m_Localized: "Des piles instables peuvent tomber sur quelqu'un. D\xE9sempilez-les
      et rangez les objets en s\xE9curit\xE9, plus bas."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931317
    m_Localized: "Ce n'est pas s\xFBr : les piles instables doivent \xEAtre d\xE9faites
      et rang\xE9es en bas."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931318
    m_Localized: "La personne \xE9valu\xE9e n'a pas remarqu\xE9 la pile de cartons
      instable pr\xE8s du passage."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931319
    m_Localized: Plusieurs cartons penchent dangereusement. Que faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 1185931320
    m_Localized: "D\xE9sempiler les cartons et les ranger plus bas, de fa\xE7on stable."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931321
    m_Localized: "Attacher les cartons ensemble avec du ruban adh\xE9sif et du film
      plastique."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931322
    m_Localized: Aligner les cartons du haut et les laisser sur la caisse.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931323
    m_Localized: "Rapprocher la caisse du mur, \xE0 c\xF4t\xE9 du passage."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931324
    m_Localized: Quel est le principal danger des cartons instables ?
    m_Metadata:
      m_Items: []
  - m_Id: 1185931325
    m_Localized: "Les cartons pourraient s'\u00e9craser et ab\u00eemer leur contenu."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931326
    m_Localized: La caisse peut occuper trop d'espace de stockage.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931327
    m_Localized: Les cartons pourraient tomber sur des personnes empruntant le passage.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931328
    m_Localized: "Le carton peut \xEAtre difficile \xE0 nettoyer correctement."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931329
    m_Localized: "Comment ranger les livraisons pour \xE9viter ce probl\xE8me ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931330
    m_Localized: "Mettre les cartons l\xE9gers en haut sans v\xE9rifier la stabilit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931331
    m_Localized: "Les ranger sur des \u00e9tag\u00e8res : cartons lourds en bas, rien au-dessus des \u00e9paules."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931332
    m_Localized: "Laisser toutes les livraisons sur des caisses le long des passages
      fr\xE9quent\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931333
    m_Localized: "Filmer les cartons serr\xE9 m\xEAme s'ils d\xE9passent de la caisse."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931334
    m_Localized: Blouse sur une chaise
    m_Metadata:
      m_Items: []
  - m_Id: 1185931335
    m_Localized: Zone de travail
    m_Metadata:
      m_Items: []
  - m_Id: 1185931336
    m_Localized: Moyen
    m_Metadata:
      m_Items: []
  - m_Id: 1185931337
    m_Localized: Protection individuelle / contamination
    m_Metadata:
      m_Items: []
  - m_Id: 1185931338
    m_Localized: EPI et comportement
    m_Metadata:
      m_Items: []
  - m_Id: 1185931339
    m_Localized: "Les blouses peuvent \xEAtre contamin\xE9es. Rangez-les sur une
      pat\xE8re ou un portant pr\xE9vu, \xE0 l'\xE9cart des si\xE8ges et des zones
      de travail."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931340
    m_Localized: "Ce n'est pas s\u00fbr : une blouse port\u00e9e se suspend, ou va dans un sac si contamin\u00e9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931341
    m_Localized: "La personne \xE9valu\xE9e n'a pas remarqu\xE9 la blouse laiss\xE9e
      sur une chaise."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931342
    m_Localized: "O\xF9 ranger la blouse apr\xE8s utilisation ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931343
    m_Localized: La plier et la poser sur la paillasse.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931344
    m_Localized: "La laisser sur la chaise jusqu'\xE0 la prochaine exp\xE9rience."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931345
    m_Localized: "La mettre dans votre casier avec votre sac et votre veste."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931346
    m_Localized: "La suspendre \u00e0 la pat\u00e8re des blouses, loin des si\u00e8ges et des sacs."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931347
    m_Localized: "Que faire si la blouse est peut-\xEAtre contamin\xE9e ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931348
    m_Localized: "Secouer les r\xE9sidus et la suspendre pour qu'elle s\xE8che."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931349
    m_Localized: "L'enlever, la fermer dans un sac et pr\u00e9venir le responsable."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931350
    m_Localized: "La rapporter chez soi et la laver avec le linge habituel."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931351
    m_Localized: "La remettre apr\xE8s avoir v\xE9rifi\xE9 l'absence de taches visibles."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931352
    m_Localized: "Pourquoi ne faut-il pas laisser les blouses sur des chaises partag\xE9es
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931353
    m_Localized: "Elles rendent les chaises plus difficiles \xE0 d\xE9placer autour
      de la paillasse."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931354
    m_Localized: "Elles r\xE9duisent le nombre de si\xE8ges disponibles pour les
      coll\xE8gues."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931355
    m_Localized: "Des r\u00e9sidus peuvent passer sur la chaise et sur la personne suivante."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931356
    m_Localized: "Elles donnent au laboratoire un aspect moins organis\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931357
    m_Localized: "Mauvais tri des d\xE9chets"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931358
    m_Localized: Zone de travail
    m_Metadata:
      m_Items: []
  - m_Id: 1185931359
    m_Localized: Moyen
    m_Metadata:
      m_Items: []
  - m_Id: 1185931360
    m_Localized: "Gestion des d\xE9chets"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931361
    m_Localized: EPI et comportement
    m_Metadata:
      m_Items: []
  - m_Id: 1185931362
    m_Localized: "Les d\xE9chets de laboratoire doivent \xEAtre s\xE9par\xE9s des
      ordures m\xE9nag\xE8res et aller dans le conteneur pr\xE9vu pour les d\xE9chets
      de laboratoire."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931363
    m_Localized: "Ce n'est pas s\u00fbr : tout ce qui a servi au labo va dans les d\u00e9chets de laboratoire."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931364
    m_Localized: "La personne \xE9valu\xE9e n'a pas remarqu\xE9 les gants usag\xE9s
      dans la poubelle ordinaire."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931365
    m_Localized: "Des gants de labo usag\xE9s sont dans la poubelle ordinaire. Que
      faire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931366
    m_Localized: "Recouvrir les gants usag\xE9s avec d'autres d\xE9chets de bureau."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931367
    m_Localized: "Les mettre dans la poubelle de d\u00e9chets de laboratoire signal\u00e9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931368
    m_Localized: Mettre les gants dans le bac de recyclage des plastiques.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931369
    m_Localized: "Laisser les gants l\xE0 jusqu'\xE0 la prochaine collecte des d\xE9chets."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931370
    m_Localized: "Vous ne savez pas si un objet n\xE9cessite un traitement sp\xE9cial
      des d\xE9chets. Que faire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931371
    m_Localized: "Le traiter comme un d\xE9chet ordinaire s'il semble sec."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931372
    m_Localized: Demander au personnel d'entretien de choisir la poubelle lors de
      la collecte.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931373
    m_Localized: "Choisir la poubelle la plus proche pour \xE9viter d'autres manipulations."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931374
    m_Localized: "Lire l'affiche de tri pr\u00e8s des poubelles ou demander au responsable."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931375
    m_Localized: "Quel objet peut normalement aller dans les ordures m\xE9nag\xE8res
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931376
    m_Localized: "Un emballage de snack propre provenant de la salle de pause pr\xE9vue."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931377
    m_Localized: "Un c\xF4ne de pipette usag\xE9 provenant d'une paillasse en activit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931378
    m_Localized: "Des gants retir\xE9s apr\xE8s manipulation de produits chimiques
      inconnus."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931379
    m_Localized: "Un liquide non identifi\xE9 provenant d'un flacon de stockage de
      r\xE9actif."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931380
    m_Localized: "Flacon chimique sans \xE9tiquette"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931381
    m_Localized: Paillasse principale
    m_Metadata:
      m_Items: []
  - m_Id: 1185931382
    m_Localized: Moyen
    m_Metadata:
      m_Items: []
  - m_Id: 1185931383
    m_Localized: Identification des produits chimiques
    m_Metadata:
      m_Items: []
  - m_Id: 1185931384
    m_Localized: Rangement et stockage
    m_Metadata:
      m_Items: []
  - m_Id: 1185931385
    m_Localized: "Ne sentez et ne videz jamais un produit chimique inconnu. Isolez-le
      et laissez le responsable ou le service HSE l'identifier, l'\xE9tiqueter ou
      l'\xE9liminer."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931386
    m_Localized: "un produit chimique inconnu ne doit jamais \xEAtre identifi\xE9
      \xE0 l'odeur ni vers\xE9 dans l'\xE9vier ; il doit \xEAtre isol\xE9 et identifi\xE9
      par le service HSE."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931387
    m_Localized: "Ce n'est pas s\xFBr : ne jamais sentir, vider ou r\xE9utiliser
      un produit chimique inconnu."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931388
    m_Localized: "La personne \xE9valu\xE9e n'a pas remarqu\xE9 le flacon de produit
      chimique sans \xE9tiquette."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931389
    m_Localized: Vous trouvez un flacon contenant un liquide incolore inconnu. Que
      faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 1185931390
    m_Localized: "Ouvrir le flacon et comparer son odeur \xE0 celle de r\xE9actifs
      connus."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931391
    m_Localized: "Tester un petit \xE9chantillon avec du papier indicateur sans le
      signaler."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931392
    m_Localized: "Le garder ferm\xE9, emp\xEAcher son utilisation et pr\xE9venir
      le responsable."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931393
    m_Localized: "Ajouter une \xE9tiquette provisoire d'apr\xE8s son emplacement
      de stockage."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931394
    m_Localized: "Un coll\xE8gue affirme que le liquide est forc\xE9ment de l'eau
      parce qu'il est incolore. Que faire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931395
    m_Localized: "En verser un peu dans l'\xE9vier pour v\xE9rifier."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931396
    m_Localized: "Ne pas l'utiliser et le mettre de c\u00f4t\u00e9 jusqu'\u00e0 ce que le responsable l'identifie."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931397
    m_Localized: "N'utiliser le liquide que pour des t\xE2ches de nettoyage simples."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931398
    m_Localized: "Comparer son aspect \xE0 celui d'autres liquides transparents."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931399
    m_Localized: Que doit-il se passer avant que ce flacon retourne au stockage chimique
      normal ?
    m_Metadata:
      m_Items: []
  - m_Id: 1185931400
    m_Localized: "Le flacon est plac\xE9 en r\xE9tention secondaire pour la nuit."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931401
    m_Localized: "Un coll\xE8gue confirme que le liquide semble inoffensif."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931402
    m_Localized: Une note provisoire indique que le contenu est inconnu.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931403
    m_Localized: "Il est identifi\u00e9 et re\u00e7oit une \u00e9tiquette compl\u00e8te : nom, dangers et date."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931404
    m_Localized: Protections manquantes et casque audio
    m_Metadata:
      m_Items: []
  - m_Id: 1185931405
    m_Localized: Paillasse principale
    m_Metadata:
      m_Items: []
  - m_Id: 1185931406
    m_Localized: Moyen
    m_Metadata:
      m_Items: []
  - m_Id: 1185931407
    m_Localized: Protection individuelle / vigilance
    m_Metadata:
      m_Items: []
  - m_Id: 1185931408
    m_Localized: EPI et comportement
    m_Metadata:
      m_Items: []
  - m_Id: 1185931409
    m_Localized: "Portez les lunettes de s\xE9curit\xE9 requises et retirez votre
      casque audio pour entendre les alarmes et vos coll\xE8gues."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931410
    m_Localized: "Ce n'est pas s\xFBr : portez des lunettes de s\xE9curit\xE9 et
      gardez les oreilles libres pour les alarmes."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931411
    m_Localized: "La personne \xE9valu\xE9e n'a pas remarqu\xE9 les lunettes de s\xE9curit\xE9
      non port\xE9es et le casque audio sur la paillasse."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931412
    m_Localized: "Vous voyez des lunettes de s\xE9curit\xE9 et un casque audio \xE0
      c\xF4t\xE9 d'un poste de travail actif. Que faire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931413
    m_Localized: "Porter les lunettes de s\xE9curit\xE9 requises et retirer le casque
      audio."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931414
    m_Localized: Garder le casque audio mais porter des lunettes ordinaires pendant
      le travail.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931415
    m_Localized: Ne porter des lunettes de protection qu'en manipulant des produits
      chimiques visibles.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931416
    m_Localized: "Baisser le volume du casque et laisser les lunettes \xE0 proximit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931417
    m_Localized: "Vous portez d\xE9j\xE0 des lunettes de vue. Quelle est la protection
      oculaire appropri\xE9e ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931418
    m_Localized: "Porter des lunettes ordinaires si leurs verres sont assez \xE9pais."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931419
    m_Localized: "Utiliser un \xE9cran facial au lieu de lunettes de s\xE9curit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931420
    m_Localized: "Porter des surlunettes de protection ou des lunettes de s\u00e9curit\u00e9 correctrices."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931421
    m_Localized: "Travailler plus loin de la paillasse pour \xE9viter l'exposition
      des yeux."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931422
    m_Localized: Pourquoi retirer le casque audio pendant le travail actif au laboratoire
      ?
    m_Metadata:
      m_Items: []
  - m_Id: 1185931423
    m_Localized: "Il n'y a de probl\u00e8me que si la musique est forte."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931424
    m_Localized: "Il peut vous emp\xEAcher d'entendre les alarmes ou vos coll\xE8gues."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931425
    m_Localized: "Il peut causer des interf\xE9rences avec les ordinateurs du laboratoire
      \xE0 proximit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931426
    m_Localized: "Le casque audio peut devenir inconfortable lors de longues exp\xE9riences."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931427
    m_Localized: "C\xE2ble d'alimentation endommag\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931428
    m_Localized: "Zone des \xE9quipements"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931429
    m_Localized: "Tr\xE8s difficile"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931430
    m_Localized: "S\xE9curit\xE9 \xE9lectrique"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931431
    m_Localized: Rangement et stockage
    m_Metadata:
      m_Items: []
  - m_Id: 1185931432
    m_Localized: "Les c\xE2bles endommag\xE9s pr\xE9sentent un risque d'\xE9lectrocution
      et d'incendie. D\xE9branchez l'appareil, \xE9tiquetez-le hors service et signalez-le
      pour remplacement."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931433
    m_Localized: "continuer d'utiliser, scotcher ou cacher un c\xE2ble endommag\xE9
      maintient en service un risque actif d'\xE9lectrocution et d'incendie."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931434
    m_Localized: "Ce n'est pas s\u00fbr : c\u00e2bles ab\u00eem\u00e9s et multiprises surcharg\u00e9es se d\u00e9branchent et se font r\u00e9parer."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931435
    m_Localized: "La personne \xE9valu\xE9e n'a pas d\xE9tect\xE9 le c\xE2ble endommag\xE9
      ni la multiprise surcharg\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931436
    m_Localized: "Vous d\xE9couvrez un c\xE2ble d'alimentation aux fils d\xE9nud\xE9s.
      Que faire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931437
    m_Localized: "Recouvrir les fils endommag\xE9s de ruban adh\xE9sif avant d'utiliser
      l'appareil."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931438
    m_Localized: "Pousser le c\xE2ble endommag\xE9 derri\xE8re l'appareil en attendant
      l'inspection."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931439
    m_Localized: "Continuer \u00e0 l'utiliser sans toucher la partie ab\u00eem\u00e9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931440
    m_Localized: "L'\u00e9teindre, le d\u00e9brancher, l'\u00e9tiqueter \u00ab Ne pas utiliser \u00bb et le signaler."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931441
    m_Localized: "Plusieurs appareils de forte puissance sont branch\xE9s sur une
      seule multiprise. Que faire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931442
    m_Localized: surcharger une multiprise avec des appareils de forte puissance
      peut la faire surchauffer et provoquer un incendie.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931443
    m_Localized: "Les r\u00e9partir sur des prises murales s\u00e9par\u00e9es ; le signaler s'il n'y en a pas assez."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931444
    m_Localized: "Ajouter une autre multiprise pour r\xE9partir les c\xE2bles sur
      les prises."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931445
    m_Localized: "Allumer les appareils un par un pour \xE9viter la surchauffe."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931446
    m_Localized: "Placer la multiprise sous la paillasse pour \xE9viter tout contact."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931447
    m_Localized: "Quand un appareil dont le c\xE2ble a \xE9t\xE9 endommag\xE9 peut-il
      \xEAtre r\xE9utilis\xE9 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931448
    m_Localized: "Une fois le c\xE2ble effiloch\xE9 recouvert d'un mat\xE9riau isolant."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931449
    m_Localized: "Une fois que l'appareil montre une alimentation stable au d\xE9marrage."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931450
    m_Localized: "Apr\u00e8s qu'un \u00e9lectricien l'a r\u00e9par\u00e9 et a v\u00e9rifi\u00e9 qu'il est s\u00fbr."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931451
    m_Localized: "Une fois qu'un coll\xE8gue a r\xE9ussi un premier essai."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931452
    m_Localized: "Trousse de secours bloqu\xE9e / incompl\xE8te"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931453
    m_Localized: "Poste de s\xE9curit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931454
    m_Localized: "Tr\xE8s difficile"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931455
    m_Localized: "Mat\xE9riel d'urgence"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931456
    m_Localized: "Voies d'\xE9vacuation"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931457
    m_Localized: "Le mat\xE9riel d'urgence doit \xEAtre accessible et complet. D\xE9gagez
      l'acc\xE8s et signalez les fournitures manquantes au service HSE."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931458
    m_Localized: "Ce n'est pas s\xFBr : les trousses de secours doivent \xEAtre accessibles
      et compl\xE8tes."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931459
    m_Localized: "La personne \xE9valu\xE9e n'a pas d\xE9tect\xE9 que l'armoire \xE9tait
      bloqu\xE9e et qu'il manquait des fournitures."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931460
    m_Localized: "Des flacons bloquent l'acc\xE8s \xE0 l'armoire de premiers secours.
      Que faire ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931461
    m_Localized: "Placer un panneau suppl\xE9mentaire pr\xE8s de l'armoire et laisser
      les flacons."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931462
    m_Localized: "Retirer les obstacles pour que l'armoire soit imm\xE9diatement
      accessible."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931463
    m_Localized: "Utiliser une autre trousse de secours sans signaler l'armoire bloqu\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931464
    m_Localized: "Fermer l'armoire et demander aux coll\xE8gues d'\xE9viter la zone."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931465
    m_Localized: Vous remarquez que plusieurs fournitures de premiers secours essentielles
      manquent. Que faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 1185931466
    m_Localized: "R\xE9organiser les fournitures restantes pour combler les vides."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931467
    m_Localized: "Demander aux coll\xE8gues d'apporter leurs propres fournitures
      jusqu'\xE0 la prochaine inspection."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931468
    m_Localized: "Attendre que quelqu'un en ait besoin avant de demander un r\xE9approvisionnement."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931469
    m_Localized: "Dire \u00e0 la personne qui g\u00e8re la trousse ce qui manque, pour qu'elle soit r\u00e9approvisionn\u00e9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931470
    m_Localized: "Que faut-il v\xE9rifier lors d'une inspection de routine des premiers
      secours ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931471
    m_Localized: "Elle est facile d'acc\u00e8s, rien ne manque et rien n'est p\u00e9rim\u00e9."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931472
    m_Localized: "L'armoire ne pr\xE9sente ni rayures, ni traces de doigts, ni autres
      marques visibles."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931473
    m_Localized: "Chaque article est rang\xE9 au-dessus du niveau des yeux pour \xE9viter
      les abus."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931474
    m_Localized: "L'armoire est verrouill\xE9e pour emp\xEAcher tout acc\xE8s inutile."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931475
    m_Localized: Mauvais stockage des produits chimiques
    m_Metadata:
      m_Items: []
  - m_Id: 1185931476
    m_Localized: Stockage chimique
    m_Metadata:
      m_Items: []
  - m_Id: 1185931477
    m_Localized: "Tr\xE8s difficile"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931478
    m_Localized: Stockage des produits chimiques
    m_Metadata:
      m_Items: []
  - m_Id: 1185931479
    m_Localized: Rangement et stockage
    m_Metadata:
      m_Items: []
  - m_Id: 1185931480
    m_Localized: "Les corrosifs se rangent en bas, en r\xE9tention secondaire, s\xE9par\xE9s
      des substances incompatibles comme les inflammables."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931481
    m_Localized: "les corrosifs ne doivent pas \xEAtre stock\xE9s en hauteur ni avec
      des substances incompatibles ; une chute ou une r\xE9action peut causer des
      blessures graves."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931482
    m_Localized: "Ce n'est pas s\xFBr : les corrosifs se rangent en bas, en r\xE9tention
      secondaire, loin des inflammables."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931483
    m_Localized: "La personne \xE9valu\xE9e n'a pas remarqu\xE9 l'acide corrosif
      stock\xE9 en hauteur \xE0 c\xF4t\xE9 de produits inflammables."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931484
    m_Localized: "Un flacon d'acide corrosif est rang\xE9 sur une \xE9tag\xE8re haute.
      O\xF9 doit-il \xEAtre stock\xE9 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931485
    m_Localized: "Sur l'\xE9tag\xE8re du haut, avec une \xE9tiquette de danger plus
      grande."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931486
    m_Localized: "Sur la m\xEAme \xE9tag\xE8re, regroup\xE9 avec des flacons de taille
      similaire."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931487
    m_Localized: "En bas dans l'armoire \u00e0 acides, pos\u00e9 dans un bac de r\u00e9tention."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931488
    m_Localized: "Dans le r\xE9frig\xE9rateur du laboratoire pour limiter le d\xE9gagement
      de vapeurs."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931489
    m_Localized: Comment organiser les acides corrosifs et les produits chimiques
      incompatibles ?
    m_Metadata:
      m_Items: []
  - m_Id: 1185931490
    m_Localized: "Tenir les acides loin des inflammables et de tout ce avec quoi ils r\u00e9agissent."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931491
    m_Localized: "Regrouper les substances selon la taille du flacon et la couleur
      de l'\xE9tiquette."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931492
    m_Localized: "Placer tous les produits chimiques liquides dans le m\xEAme bac
      de r\xE9tention."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931493
    m_Localized: Stocker ensemble corrosifs et inflammables pour gagner de la place.
    m_Metadata:
      m_Items: []
  - m_Id: 1185931494
    m_Localized: "Pourquoi est-il dangereux de stocker du HCl au-dessus de la t\xEAte,
      \xE0 c\xF4t\xE9 de produits incompatibles ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1185931495
    m_Localized: "Les petits flacons de produits chimiques peuvent devenir difficiles
      \xE0 trouver."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931496
    m_Localized: "S'il tombe, l'acide peut \u00e9clabousser le visage et r\u00e9agir avec d'autres flacons."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931497
    m_Localized: "Les \xE9tiquettes peuvent p\xE2lir plus vite sur les \xE9tag\xE8res
      du haut."
    m_Metadata:
      m_Items: []
  - m_Id: 1185931498
    m_Localized: "Le rangement peut sembler d\xE9sorganis\xE9 lors des inspections
      de s\xE9curit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 177914296393728
    m_Localized: "Lors d'une \u00e9vacuation, beaucoup de gens sortent en m\u00eame temps, parfois dans la fum\u00e9e. Une sortie \u00e0 moiti\u00e9 bloqu\u00e9e ou un panneau sur le chariot ne les aide pas : il faut l'enlever."
    m_Metadata:
      m_Items: []
  - m_Id: 177914380279808
    m_Localized: "Une sortie n'est utilisable que si tout le chemin vers l'ext\xE9rieur
      est d\xE9gag\xE9, pas seulement la porte."
    m_Metadata:
      m_Items: []
  - m_Id: 177914380279809
    m_Localized: 'Une urgence peut aussi survenir pendant ces dix minutes : le chariot
      n''attend donc jamais devant la sortie.'
    m_Metadata:
      m_Items: []
  - m_Id: 177914380279810
    m_Localized: "Une boisson pos\xE9e pr\xE8s du mat\xE9riel peut recueillir des
      r\xE9sidus chimiques qui seront aval\xE9s. Ne buvez qu'\xE0 l'ext\xE9rieur
      du laboratoire."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668416
    m_Localized: "Un gobelet anti-renversement ou un couvercle ferm\xE9 reste une
      boisson dans le laboratoire. La solution s\xFBre est une courte pause hors
      du laboratoire."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668417
    m_Localized: "Le couvercle garde le caf\u00e9 dedans, pas les produits dehors. Les r\u00e9sidus sur vos gants, vos mains et l'ext\u00e9rieur de la tasse arrivent \u00e0 votre bouche \u00e0 la prochaine gorg\u00e9e."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668418
    m_Localized: Scotcher ou aligner la pile laisse des cartons lourds en hauteur.
      Seul un rangement bas et stable supprime le risque de chute.
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668419
    m_Localized: Une pile qui tombe peut blesser les personnes dans le passage et
      le bloquer.
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668420
    m_Localized: "Des cartons lourds en bas et des piles basses ne peuvent tomber sur personne. Le ruban adh\u00e9sif ou le film ne tient une mauvaise pile que jusqu'\u00e0 ce qu'elle tombe."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668421
    m_Localized: "Une blouse port\u00e9e peut garder des r\u00e9sidus chimiques. Sur sa pat\u00e8re, elle ne touche ni les si\u00e8ges, ni les sacs, ni vos v\u00eatements."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668422
    m_Localized: "Une blouse contamin\u00e9e s'enl\u00e8ve tout de suite et est nettoy\u00e9e par le laboratoire. La secouer, la remettre ou la laver chez soi propage le produit."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668423
    m_Localized: "N'importe qui peut s'y asseoir ensuite, en v\u00eatements normaux. Les r\u00e9sidus de la blouse passent sur la chaise, puis sur cette personne."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668424
    m_Localized: "Les gants de labo peuvent porter des r\u00e9sidus chimiques. Dans la poubelle normale, ils arrivent au personnel de nettoyage et aux ordures m\u00e9nag\u00e8res, sans pr\u00e9caution."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668425
    m_Localized: "Deviner peut envoyer des d\u00e9chets dangereux dans la mauvaise poubelle. L'affiche de tri ou le responsable vous dit o\u00f9 ils vont."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668426
    m_Localized: "Seuls les objets qui n'ont jamais servi au travail de laboratoire,
      comme un emballage propre de la salle de pause, sont des d\xE9chets m\xE9nagers."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668427
    m_Localized: "Un liquide inconnu peut \xEAtre n'importe quoi. Gardez-le ferm\xE9
      et hors d'usage pour que personne ne le sente, ne l'utilise ni ne le vide."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668428
    m_Localized: "Les acides, l'eau de Javel et beaucoup de solvants ressemblent \u00e0 de l'eau, et dans l'\u00e9vier ils peuvent r\u00e9agir ou d\u00e9gager des vapeurs. L'apparence ne dit rien."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668429
    m_Localized: "Tout le monde se fie \u00e0 l'\u00e9tiquette pour savoir ce que contient un flacon. Tant qu'il n'est pas identifi\u00e9 et \u00e9tiquet\u00e9, la personne suivante fait face au m\u00eame inconnu."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668430
    m_Localized: "Les lunettes de s\xE9curit\xE9 prot\xE8gent des \xE9claboussures,
      et sans casque audio vous entendez les alarmes et vos coll\xE8gues."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668431
    m_Localized: "Des lunettes normales n'arr\u00eatent ni les \u00e9claboussures ni les \u00e9clats de verre, et laissent les c\u00f4t\u00e9s ouverts. Des lunettes de protection se portent par-dessus."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668432
    m_Localized: "Un casque audio peut masquer les alarmes incendie et les avertissements
      cri\xE9s par les coll\xE8gues."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668433
    m_Localized: "Des fils \u00e0 nu peuvent \u00e9lectrocuter ou provoquer un incendie. D\u00e9branch\u00e9 et \u00e9tiquet\u00e9, personne ne peut l'utiliser par erreur avant sa r\u00e9paration."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668434
    m_Localized: "Trop d'appareils puissants sur une multiprise la font chauffer et peuvent causer un incendie. Des prises murales s\u00e9par\u00e9es partagent la charge, une autre multiprise non."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668435
    m_Localized: "Du ruban adh\u00e9sif ou un essai r\u00e9ussi ne r\u00e9parent pas un c\u00e2ble endommag\u00e9. Seuls une vraie r\u00e9paration et un contr\u00f4le le rendent \u00e0 nouveau s\u00fbr."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668436
    m_Localized: "En cas d'urgence, chaque seconde compte : l'armoire de premiers
      secours doit \xEAtre accessible imm\xE9diatement."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668437
    m_Localized: "Signalez le mat\xE9riel manquant pour qu'il soit r\xE9approvisionn\xE9
      avant que quelqu'un en ait besoin."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668438
    m_Localized: "Une trousse bloqu\u00e9e, \u00e0 moiti\u00e9 vide ou p\u00e9rim\u00e9e vous l\u00e2che justement quand quelqu'un est bless\u00e9."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668439
    m_Localized: "En bas, il ne peut tomber sur personne, et le bac de r\u00e9tention retient toute fuite."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668440
    m_Localized: "Si des produits incompatibles se m\u00e9langent en fuyant, ils peuvent chauffer, d\u00e9gager des vapeurs ou prendre feu. Triez selon ce qui r\u00e9agit avec quoi, pas selon la taille ou la couleur."
    m_Metadata:
      m_Items: []
  - m_Id: 177914388668441
    m_Localized: "Un flacon qui tombe d'au-dessus de la t\xEAte peut projeter de
      l'acide sur le visage et les yeux, et r\xE9agir avec ce qu'il touche."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
