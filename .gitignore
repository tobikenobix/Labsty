# ==============================================================================
# UNITY STANDARD DIRECTORIES
# ==============================================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get massive in VR profiling
/[Mm]emoryCaptures/

# Recordings (Unity Recorder / VR session captures)
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is ignored
!/[Aa]ssets/**/*.meta

# Uncomment if you want to ignore Asset Store packages (re-downloaded via Package Manager)
# /[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*

# ==============================================================================
# AUTOGENERATED PROJECT & IDE FILES
# ==============================================================================
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# ==============================================================================
# VR / XR SPECIFIC (Meta Quest, SteamVR, OpenXR, Pico)
# ==============================================================================
# Oculus / Meta XR SDK cache & generated files
/[Aa]ssets/Oculus/OculusProjectConfig.asset*
/[Aa]ssets/XR/Settings/OpenXRPackageSettings.asset*
/Oculus/
.oculus/
ovr_logs/

# SteamVR generated input bindings & actions (keep your custom ones if needed)
/SteamVR_Input/
/Assets/SteamVR_Input/

# XR Interaction Toolkit / OpenXR temp caches
/[Ll]ibrary/XR/

# ==============================================================================
# STANDALONE VR BUILDS (Quest, Pico, Vive Focus - Android / APK / AAB)
# ==============================================================================
*.apk
*.aab
*.unitypackage
*.app
*.obb

# Android / Gradle build caches
/[Aa]ssets/Plugins/Android/mainTemplate.gradle.DISABLED
/[Aa]ssets/Plugins/Android/settingsTemplate.gradle.DISABLED
.gradle/
build/

# ==============================================================================
# BAKED LIGHTING & HEAVY GENERATED DATA (Optional - uncomment if team re-bakes)
# ==============================================================================
# Baked lightmaps and reflection probes can bloat Git repos quickly in VR scenes
# /[Aa]ssets/**/LightingData.asset
# /[Aa]ssets/**/Lightmap-*
# /[Aa]ssets/**/ReflectionProbe-*

# ==============================================================================
# OS & MISCELLANEOUS
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
